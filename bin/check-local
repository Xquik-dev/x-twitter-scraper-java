#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

# Runs every repository check in order and stops at the first failure.
# Posts the result as the xquik-local-checks commit status on GitHub.
# Pass --no-status to skip the status.

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

readonly repo="Xquik-dev/x-twitter-scraper-java"
readonly status_context="xquik-local-checks"

post_status_enabled=true
status_sha=""
current_check=""
skipped_note=""

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

for arg in "$@"; do
    case "$arg" in
        --no-status) post_status_enabled=false ;;
        *) fail "Unknown option $arg. Pass --no-status or nothing." ;;
    esac
done

skip_status() {
    printf 'Not posting the %s status because %s\n' "$status_context" "$1"
}

post_status() {
    if ! gh api --method POST "repos/$repo/statuses/$status_sha" \
        -f state="$1" \
        -f context="$status_context" \
        -f description="$2" \
        --silent; then
        printf 'Could not post the %s status. Check gh auth status.\n' "$status_context" >&2
    fi
}

prepare_status() {
    local sha
    if [[ "$post_status_enabled" == false ]]; then
        skip_status "--no-status was passed."
    elif ! command -v gh >/dev/null 2>&1; then
        skip_status "gh is not installed."
    elif ! git rev-parse --git-dir >/dev/null 2>&1; then
        skip_status "this is not a Git checkout."
    elif [[ -n "$(git status --porcelain)" ]]; then
        skip_status "the working tree has uncommitted changes."
    else
        sha="$(git rev-parse HEAD)"
        if gh api "repos/$repo/commits/$sha" --silent >/dev/null 2>&1; then
            status_sha="$sha"
        else
            skip_status "commit ${sha:0:12} is not on GitHub. Push it first."
        fi
    fi
}

finish_status() {
    local exit_code=$?
    if ((exit_code == 0)); then
        post_status success \
            "Format, ShellCheck, build, tests, coverage, fuzzing, audit & reproducibility passed$skipped_note"
    else
        post_status failure "Failed: ${current_check:-setup}. Run bin/check-local to see why."
    fi
}

run_check() {
    local name="$1"
    local advice="$2"
    shift 2
    current_check="$name"
    printf '==> %s\n' "$name"
    if ! "$@"; then
        fail "Check failed: $name. $advice"
    fi
}

jdks_ready() {
    local java_bin="java"
    if [[ -n "${JAVA_HOME:-}" ]]; then
        java_bin="$JAVA_HOME/bin/java"
    fi
    "$java_bin" -version >/dev/null 2>&1 &&
        [[ -f "${SHRINKER_JAVA_HOME:-}/release" ]] &&
        grep -q '^JAVA_VERSION="25' "$SHRINKER_JAVA_HOME/release"
}

check_shell_scripts() {
    if ! command -v shellcheck >/dev/null 2>&1; then
        printf 'shellcheck is not installed.\n' >&2
        return 1
    fi
    shellcheck bin/* scripts/*
}

fuzz_retry_headers() {
    JAZZER_FUZZ=1 ./gradlew \
        :x-twitter-scraper-java-core:test \
        --tests '*RetryAfterFuzzTest' \
        --no-build-cache \
        --no-configuration-cache
}

prepare_status
if [[ -n "$status_sha" ]]; then
    trap finish_status EXIT
    post_status pending "Running local checks"
fi

run_check "JDK setup" \
    "Set JAVA_HOME to JDK 26 and SHRINKER_JAVA_HOME to JDK 25." \
    jdks_ready

run_check "Java and Kotlin formatting" \
    "Run ./scripts/format, then rerun bin/check-local." \
    ./scripts/lint

run_check "Shell scripts" \
    "Install shellcheck if it is missing, then fix the findings above." \
    check_shell_scripts

if command -v reuse >/dev/null 2>&1; then
    run_check "Repository licensing" \
        "Add SPDX license details for the files listed above." \
        reuse lint
else
    skipped_note="; REUSE skipped"
    printf '==> Skipping repository licensing because reuse is not installed\n'
fi

run_check "Build" \
    "Fix the compiler errors above." \
    ./scripts/build

run_check "Tests" \
    "Fix the failing or skipped tests above." \
    ./scripts/test

run_check "Coverage" \
    "Add tests until maintained code has 90% line and 80% branch coverage." \
    ./scripts/coverage

run_check "Retry header fuzzing" \
    "Fix the retry delay bug in the fuzz finding above." \
    fuzz_retry_headers

run_check "Dependency audit" \
    "Upgrade or replace the dependencies flagged above." \
    ./scripts/audit

run_check "Reproducible Maven artifacts" \
    "Remove the build input that differs between the 2 builds above." \
    ./scripts/check-reproducible

printf 'All local checks passed.\n'
